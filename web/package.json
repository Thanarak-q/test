{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run test:docs-release && bun run build:check",
    "build:check": "vite build && tsc --noEmit",
    "test:docs-release": "vitest run --mode production src/content/docs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "gen:api": "orval"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@nanostores/persistent": "1.3.5",
    "@nanostores/react": "2.0.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.23",
    "lucide-react": "1.41.0",
    "nanostores": "1.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdx-js/rollup": "3.1.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.8",
    "@tanstack/router-plugin": "1.168.35",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "orval": "8.28.1",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
