# Staging / production. Copy, fill in every <...>, and keep the real file out
# of git. Values marked "decide" are provisional — see docs/HANDOFF.md §2.
# List values are JSON arrays.

ENV=production

# The app's own DB user (docs/DB_PERMISSIONS.md), not the migration user.
DATABASE_URL=mysql+aiomysql://matthew_app:<password>@<mysql-host>:3306/matthew?charset=utf8mb4
# decide: the database is shared with the main application.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Must be the same, non-cluster Redis that holds the main application's
# quota:{user_id} (docs/HANDOFF.md §1.2).
REDIS_URL=redis://<redis-host>:6379/0

CORS_ORIGINS=["https://<dashboard-origin>"]
ALLOWED_HOSTS=["<api-hostname>"]
# nginx in front of the API; it must overwrite X-Real-IP and
# X-Forwarded-Proto with proxy_set_header (docs/HANDOFF.md §1.3).
TRUSTED_PROXY_IPS=["<nginx-ip>"]
APP_TZ=Asia/Bangkok

LLM_BASE_URL=https://api.openai.com/v1
# The provider key, mounted from the secret store — a different key per
# environment. Read on every call, so rotating it needs no restart.
# Required: the API refuses to start in staging/production without it.
LLM_API_KEY_FILE=/run/secrets/llm_api_key
# decide: used only when quota:{user_id} has no `limit`.
LLM_TOKEN_QUOTA=1000000

# A test account with a real quota:{user_id}, for app.jobs.quota_health.
QUOTA_HEALTH_USER_ID=<test-user-id>

# Never set LLM_API_KEY, DEV_SESSION_USER_ID or DEV_SESSION_ROLE here.
# The API refuses to start with DEV_SESSION_USER_ID outside ENV=dev.
