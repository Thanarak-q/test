# Local development. For staging/production see .env.production.example.
# List values (CORS_ORIGINS, ALLOWED_HOSTS, TRUSTED_PROXY_IPS) are JSON arrays.

# production | staging | test | dev. Defaults to production when unset.
ENV=dev

DATABASE_URL=mysql+aiomysql://matthew:matthew@localhost:3310/matthew?charset=utf8mb4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# The same Redis the main application keeps quota:{user_id} in.
REDIS_URL=redis://localhost:6389/0

CORS_ORIGINS=["http://localhost:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Only requests from these addresses may set X-Real-IP / X-Forwarded-Proto.
# Locally there is no nginx: send those two headers yourself when calling
# /v1/chat/completions (see docs/HANDOFF.md, "รันในเครื่อง").
TRUSTED_PROXY_IPS=["127.0.0.1"]
APP_TZ=Asia/Bangkok

LLM_BASE_URL=https://api.openai.com/v1
# Dev only: the provider key straight from the environment. Staging and
# production read it from LLM_API_KEY_FILE (a mounted secret) instead.
LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_api_key
# Used only when the main application's quota:{user_id} has no `limit`.
LLM_TOKEN_QUOTA=1000000

# A test account whose quota:{user_id} the quota health job checks.
# QUOTA_HEALTH_USER_ID=

# Dev only: act as this user without the main application's session.
# The API refuses to start if this is set while ENV is not "dev".
DEV_SESSION_USER_ID=1
# user | admin — admin opens /admin/models in the dashboard.
DEV_SESSION_ROLE=user
